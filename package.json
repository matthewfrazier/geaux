{
  "name": "geaux-mcp-server",
  "version": "0.1.0",
  "description": "MCP service for managing code deployment to Dev, preproduction and production environments",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "geaux-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
